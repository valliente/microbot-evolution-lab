    <style rel="stylesheet" crossorigin>@import"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap";*{box-sizing:border-box;margin:0;padding:0}:root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,sans-serif;color-scheme:dark;background-color:#030712;color:#f8fafc}body{background-color:#030712;color:#f8fafc;overflow-x:hidden;user-select:none}::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:#090d16}::-webkit-scrollbar-thumb{background:#1e293b;border-radius:4px}::-webkit-scrollbar-thumb:hover{background:#00f0ff}.app-container{min-height:100vh;background-color:#030712;display:flex;flex-direction:column}.header-bar{width:100%;background:#0f172af2;backdrop-filter:blur(12px);border-bottom:1px solid rgba(0,240,255,.2);padding:12px 20px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;box-shadow:0 4px 20px #00000080;position:sticky;top:0;z-index:40}.logo-group{display:flex;align-items:center;gap:12px}.logo-icon{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#00f0ff,#2563eb);padding:2px;display:flex;align-items:center;justify-content:center;box-shadow:0 0 15px #00f0ff66}.logo-inner{width:100%;height:100%;background:#030712;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#00f0ff}.title-text{font-family:JetBrains Mono,monospace;font-size:1.2rem;font-weight:800;color:#fff;letter-spacing:-.5px}.title-highlight{color:#00f0ff}.subtitle-text{font-size:.75rem;color:#94a3b8}.main-workspace{flex:1;padding:16px;display:grid;grid-template-columns:350px 1fr;gap:16px;max-width:1920px;margin:0 auto;width:100%}@media (max-width: 1080px){.main-workspace{grid-template-columns:1fr}}.left-sidebar,.right-viewport{display:flex;flex-direction:column;gap:16px}.panel-card{background:#0f172ad9;backdrop-filter:blur(10px);border:1px solid rgba(0,240,255,.2);border-radius:14px;padding:16px;box-shadow:0 8px 32px #0006}.panel-header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.1);padding-bottom:8px;margin-bottom:12px;color:#00f0ff;font-family:JetBrains Mono,monospace;font-size:.8rem;font-weight:700;text-transform:uppercase}.canvas-wrapper{position:relative;width:100%;height:560px;min-height:480px;background:#080c14;border:2px solid rgba(0,240,255,.3);border-radius:14px;overflow:hidden;box-shadow:0 10px 40px #0009}.canvas-element{width:100%;height:100%;display:block;cursor:crosshair}.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 14px;border-radius:8px;font-size:.75rem;font-weight:700;cursor:pointer;transition:all .2s ease;border:1px solid transparent;font-family:JetBrains Mono,monospace;text-decoration:none}.btn-primary{background:linear-gradient(135deg,#10b981,#059669);color:#fff;border-color:#10b981;box-shadow:0 0 15px #10b98166}.btn-primary:hover{background:linear-gradient(135deg,#34d399,#10b981);transform:translateY(-1px)}.btn-cyan{background:#00f0ff;color:#030712;border-color:#00f0ff;box-shadow:0 0 12px #00f0ff4d}.btn-cyan:hover{background:#38bdf8;border-color:#38bdf8;transform:translateY(-1px)}.btn-purple{background:#a855f740;color:#c084fc;border-color:#a855f780}.btn-purple:hover{background:#a855f773;color:#fff}.btn-emerald{background:#10b98140;color:#34d399;border-color:#10b98180}.btn-emerald:hover{background:#10b98173;color:#fff}.btn-rose{background:#f43f5e40;color:#fb7185;border-color:#f43f5e80}.btn-rose:hover{background:#f43f5e73;color:#fff}.btn-dark{background:#1e293bcc;color:#cbd5e1;border-color:#334155}.btn-dark:hover{background:#334155;color:#fff}.control-item{background:#03071299;padding:10px 12px;border-radius:8px;border:1px solid rgba(255,255,255,.08);margin-bottom:8px}.control-label-row{display:flex;justify-content:space-between;font-family:JetBrains Mono,monospace;font-size:.72rem;color:#cbd5e1;margin-bottom:6px}.control-value{font-weight:700}.slider-input{width:100%;height:6px;background:#1e293b;border-radius:4px;outline:none;cursor:pointer;accent-color:#00f0ff}.toggle-item{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:#03071299;border:1px solid rgba(255,255,255,.08);border-radius:8px;font-size:.75rem;color:#cbd5e1;cursor:pointer}.checkbox-input{width:16px;height:16px;accent-color:#00f0ff;cursor:pointer}.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px}.metric-card{background:#030712b3;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;justify-content:space-between}.metric-title{font-size:.65rem;font-family:JetBrains Mono,monospace;color:#94a3b8;display:flex;align-items:center;gap:4px}.metric-value{font-size:1.25rem;font-weight:700;font-family:JetBrains Mono,monospace;margin-top:4px}.text-cyan{color:#00f0ff}.text-purple{color:#c084fc}.text-emerald{color:#34d399}.text-rose{color:#fb7185}.text-blue{color:#60a5fa}.text-amber{color:#fbbf24}</style>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
