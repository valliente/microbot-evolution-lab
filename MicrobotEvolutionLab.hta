<!DOCTYPE html>
<html lang="en">
  <head>
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<HTA:APPLICATION
    ID="MicrobotEvolutionLabApp"
    APPLICATIONNAME="Microbot Evolution Lab"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="no"
    SYSMENU="yes"
    WINDOWSTATE="maximize"
    SCROLL="no">
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='45' fill='%2300f0ff' opacity='0.3'/><circle cx='50' cy='50' r='25' fill='%2300f0ff'/></svg>" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Microbot Evolution Lab - 2D Artificial Life Simulation</title>
    <meta name="description" content="Interactive 2D artificial life simulation exploring autonomous microbot navigation, battery mechanics, energy collection, hazard avoidance, and genetic mutation over generations." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
