<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>Microbot Evolution Lab</title>
<HTA:APPLICATION
  ID="MicrobotEvolutionLabApp"
  APPLICATIONNAME="Microbot Evolution Lab"
  BORDER="thin"
  BORDERSTYLE="normal"
  CAPTION="yes"
  ICON="favicon.ico"
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="maximize"
  NAVIGABLE="yes"
/>

