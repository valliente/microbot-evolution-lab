    <style rel="stylesheet" crossorigin>:root{--bg-dark: #030712;--panel-bg: rgba(15, 23, 42, .85);--panel-border: rgba(255, 255, 255, .1);--primary-cyan: #00f0ff;--emerald-accent: #10b981;--rose-accent: #f43f5e;--purple-accent: #a855f7;--amber-accent: #fbbf24;--text-main: #f8fafc;--text-muted: #94a3b8}*{box-sizing:border-box;margin:0;padding:0}body{font-family:Inter,system-ui,-apple-system,sans-serif;background-color:var(--bg-dark);color:var(--text-main);min-height:100vh;overflow-x:hidden}.app-container{display:flex;flex-direction:column;height:100vh;width:100vw;overflow:hidden;background:radial-gradient(circle at 50% 0%,#0f172a,#030712)}.header-bar{display:flex;align-items:center;justify-content:space-between;padding:12px 20px;background:#0f172ae6;border-bottom:1px solid var(--panel-border);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);z-index:20}.logo-group{display:flex;align-items:center;gap:12px}.logo-icon{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#00f0ff,#7c3aed);display:flex;align-items:center;justify-content:center;box-shadow:0 0 15px #00f0ff66}.logo-inner{color:#fff;display:flex}.title-text{font-family:JetBrains Mono,monospace;font-size:1.1rem;font-weight:800;letter-spacing:-.02em;color:#fff}.title-highlight{color:var(--primary-cyan)}.subtitle-text{font-size:.72rem;color:var(--text-muted)}.main-workspace{display:flex;flex:1;overflow:hidden;position:relative}.left-sidebar{width:340px;display:flex;flex-direction:column;gap:12px;padding:14px;overflow-y:auto;border-right:1px solid var(--panel-border);background:#03071266}.right-viewport{flex:1;display:flex;flex-direction:column;gap:12px;padding:14px;overflow:hidden}.canvas-container{flex:1;position:relative;border-radius:14px;border:1px solid var(--panel-border);overflow:hidden;background:#000;box-shadow:inset 0 0 30px #000c,0 0 20px #00f0ff0d}.panel-card{background:var(--panel-bg);border:1px solid var(--panel-border);border-radius:14px;padding:14px;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}.panel-header{font-family:JetBrains Mono,monospace;font-size:.82rem;font-weight:700;color:var(--primary-cyan);text-transform:uppercase;letter-spacing:.05em;margin-bottom:12px;display:flex;align-items:center;gap:8px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 14px;border-radius:8px;font-size:.78rem;font-weight:700;font-family:JetBrains Mono,monospace;cursor:pointer;border:1px solid transparent;transition:all .2s ease}.btn-cyan{background:#00f0ff26;border-color:#00f0ff66;color:var(--primary-cyan)}.btn-cyan:hover{background:#00f0ff4d;box-shadow:0 0 12px #00f0ff66}.btn-emerald{background:#10b98126;border-color:#10b98166;color:#34d399}.btn-emerald:hover{background:#10b9814d;box-shadow:0 0 12px #10b98166}.btn-rose{background:#f43f5e26;border-color:#f43f5e66;color:#fb7185}.btn-rose:hover{background:#f43f5e4d;box-shadow:0 0 12px #f43f5e66}.btn-purple{background:#a855f726;border-color:#a855f766;color:#c084fc}.btn-purple:hover{background:#a855f74d;box-shadow:0 0 12px #a855f766}.btn-dark{background:#1e293b99;border-color:#ffffff1a;color:var(--text-muted)}.btn-dark:hover{background:#334155cc;color:#fff}.slider-group{display:flex;flex-direction:column;gap:4px;margin-bottom:10px}.slider-label{display:flex;justify-content:space-between;font-size:.72rem;color:var(--text-muted);font-family:JetBrains Mono,monospace}.slider-value{color:var(--primary-cyan);font-weight:700}input[type=range]{accent-color:var(--primary-cyan);cursor:pointer}</style>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
